# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_MAPTILER_API_KEY: Optional MapTiler Cloud API key for high-resolution vector and satellite maps.
# Users configure this via the Secrets panel in the AI Studio UI.
# When configured, activates MapTiler Streets, Satellite Hybrid, Outdoor, and Dataviz basemaps.
VITE_MAPTILER_API_KEY=wkndVymjmsbf6Y0M1QG4

# VITE_MAPTILER_API_TOKEN: Optional MapTiler Cloud Access / Session Token.
# Users configure this via the Secrets panel in the AI Studio UI.
# Can be used independently or alongside VITE_MAPTILER_API_KEY for authorized tile requests.
VITE_MAPTILER_API_TOKEN=4944422b95dd4dcfba73ddc23520d066_3ebe7e7a3e239c7de29d29becadb0f73b2e8acd4a3285c9d477557f7cec3c86f

# VITE_SUPABASE_URL: The Supabase Project URL for the VECTOR Database & Auth backend
VITE_SUPABASE_URL=https://vector-logistics-ops.supabase.co

# VITE_SUPABASE_ANON_KEY: The Supabase public anon key for database and realtime connectivity
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM1MDQ4MDAsImlhdCI6MTcwMDAwMDAwMH0.vector_ops_demo_key

